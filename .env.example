# NutriCheck environment (copy to .env.local)

# App → API
# Prefer leaving this as localhost — the app rewrites it to your Expo host IP
# on physical devices, and to 10.0.2.2 on Android emulators.
EXPO_PUBLIC_API_URL=http://localhost:4000

# Optional override if auto-detection fails (use your PC's LAN IP):
# EXPO_PUBLIC_API_URL=http://192.168.1.37:4000

# ─── Server (pnpm api) ───────────────────────────────────────────
# PORT=4000
# JWT_SECRET: required in production, min 32 chars (boot fails otherwise).
# Dev fallback warns but still runs. Generate with: openssl rand -base64 32
# JWT_SECRET=change-me-in-production-min-32-chars-long-please

# ─── AI layer (server-side only — keys never ship in the app) ────
# Pick ONE provider. With a key set, the app gets real food-image
# recognition AND AI nutrition analysis. Without one, scans fail
# gracefully and nutrition checks use the local rules engine.

# Option A: Google Gemini (has a free tier)
# GEMINI_API_KEY=your-key
# GEMINI_MODEL=gemini-3.5-flash

# Option B: OpenAI-compatible (OpenAI, OpenRouter, Groq, Ollama, ...)
# OPENAI_API_KEY=your-key
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini

# Optional legacy override: proxy food images to an external vision
# endpoint instead of using the built-in AI layer.
# FOOD_VISION_API_URL=https://your-vision-provider/identify

# Client-side direct vision fallback (skips the NutriCheck server entirely —
# prefer the server-side FOOD_VISION_API_URL above instead).
# EXPO_PUBLIC_FOOD_VISION_API_URL=https://your-vision-provider/identify

# ─── Server hardening (optional in dev) ────────────────────────────────
# Comma-separated allowed origins. Defaults to open for Expo Go / LAN dev.
# When set or open, methods are restricted to GET,POST,PATCH,DELETE with
# allowedHeaders Content-Type,Authorization and maxAge 86400.
# CORS_ORIGINS=https://your-app.example.com
# JWT_SECRET is required in production (>=32 chars, dev default warns, never ships).
